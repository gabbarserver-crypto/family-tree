+
+/* ---- Relationship Finder pickers: photo thumbnail + Father/Husband chips ---- */
+.rel-input-row{position:relative;display:block}
+.rel-input-row input{width:100%}
+.rel-input-row input.has-thumb{padding-left:56px}
+.rel-thumb{position:absolute;left:8px;top:50%;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;overflow:hidden;display:grid;place-items:center;pointer-events:none;z-index:1}
+.rel-thumb[hidden]{display:none!important}
+.rel-thumb .avatar,.rel-thumb-av{width:36px!important;height:36px!important;min-width:36px;font-size:13px;border-radius:50%}
+.rel-pick-option{align-items:flex-start;gap:12px}
+.rel-pick-avatar{width:46px!important;height:46px!important;min-width:46px;border-radius:50%;overflow:hidden;font-size:15px}
+.rel-pick-copy{gap:4px}
+.rel-kin-row{display:flex;flex-wrap:wrap;gap:4px 6px}
+.rel-kin{display:inline-flex;gap:4px;align-items:baseline;font-size:12px;line-height:1.3;padding:2px 8px;border-radius:999px;background:var(--plum-tint);color:var(--ink)}
+.rel-kin em{font-style:normal;font-weight:600;color:var(--ink-soft)}
+.rel-kin-none{background:transparent;padding:0;color:var(--ink-soft)}
+.inv-add-grid .rel-pick-menu{min-width:0}
+.inv-add-grid .rel-pick-wrap{margin:8px 0}
